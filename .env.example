# ===== LLM（可缺省：无 Key 时回退 FakeLLM，流程可跑但打分无意义）=====
# 方式一：显式三件套（缺一即启动报错，fail-fast）
# LLM_MODE=openai          # openai | anthropic
# LLM_BASE_URL=https://api.minimaxi.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=MiniMax-M3

# 方式二：复用本机 .claude/settings.local.json 注入的 MiniMax 变量
# MINIMAX_API_KEY / MINIMAX_API_HOST 已由 Claude Code 注入，无需配置
# MINIMAX_MODEL=MiniMax-M3   # 缺省即 MiniMax-M3；注意 image-01 是图像模型不能用

# ===== 工作台 =====
# APP_PORT=8610              # FastAPI 端口（前端 vite dev=5610）
# WORKBENCH_DB_PATH=data/workbench.db   # SQLite 落盘位置

# ===== 网络 =====
# 若本机代理（HTTP_PROXY/HTTPS_PROXY）对 eastmoney 断流，给 NO_PROXY 追加：
# NO_PROXY=localhost,127.0.0.1,.eastmoney.com
